# Non-secret template only. Do not copy credentials to a host without approval.
PRSEC_MODE=durable
PRSEC_ALLOWED_REPOSITORY=lansiquo/sast-triage
PRSEC_ALLOWED_INSTALLATION_ID=80788483
PRSEC_JOB_DB=/srv/sast-triage/state/jobs.sqlite3
# Requires an operator-provisioned shared queue group and directory mode 2770.
PRSEC_SHARED_STATE=1
PRSEC_SCANNER_BACKEND=docker
# semgrep remains the default; opengrep is an evaluated alternative, not yet approved for deployment.
PRSEC_SCANNER_COMMAND=semgrep
# Must be an approved, audited image referenced by its immutable digest.
PRSEC_SCANNER_IMAGE=
# Set for the deployment user's existing ROOTLESS Docker daemon:
DOCKER_HOST=unix:///run/user/REPLACE_UID/docker.sock
PRSEC_LOAD_DOTENV=0
GITHUB_APP_ID=1776205
# Store the existing App PEM in the approved host's secret store, never in Git.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
SEMGREP_TIMEOUT_S=120
HTTP_TIMEOUT_S=25
