# ---- PR Security Reviewer — environment ----
# Copy to .env and fill in. Never commit .env or your private key.

# GitHub App credentials (from the App's settings page)
GITHUB_APP_ID=123456
# Provide the PEM either as a file path (preferred on a server)...
GITHUB_APP_PRIVATE_KEY_PATH=/app/secrets/github-app.pem
# ...or inline (escape newlines as \n). Leave blank if using the path above.
GITHUB_APP_PRIVATE_KEY=

# Webhook signature verification (REQUIRED for a public deployment).
# Set the same secret in the GitHub App's webhook config.
GITHUB_WEBHOOK_SECRET=change_me_to_a_long_random_string
# For zero-downtime secret rotation you may list several, comma-separated:
# GITHUB_WEBHOOK_SECRETS=new_secret,old_secret
# Leave this at 0 in production so unsigned/forged webhooks are rejected.
ALLOW_UNVERIFIED_WEBHOOKS=0

# Check run name shown on the PR
PRSEC_CHECK_NAME=RobinSec

# Scanning behaviour
PRSEC_FORCE_OFFLINE=1          # use the embedded offline ruleset (deterministic, no registry)
PRSEC_SEMGREP_MIN_SEVERITY=LOW
PRSEC_MAX_ANNOTATIONS=200
# SEMGREP_CONFIG=p/security-audit   # optional extra config (registry id or URL)
# SEMGREP_EXCLUDE=tests,examples

# Timeouts (seconds)
HTTP_TIMEOUT_S=25
SEMGREP_TIMEOUT_S=120
PIPELINE_DEADLINE_S=90
WATCHDOG_GRACE_S=20

# Server
PORT=8000
LOGLEVEL=INFO
